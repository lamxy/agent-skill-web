# ══════════════════════════════════════════════════════════════
# 以下為應用讀取的變數，集中定義於 src/shared/config/config.ts
# ══════════════════════════════════════════════════════════════

# ── 應用執行（必填）──
NODE_ENV="development"
HOST="127.0.0.1"
PORT="3000"
LOG_LEVEL="debug"
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:55432/agent_skill_platform"
TELEMETRY_ENDPOINT="http://127.0.0.1:3000"

# ── SSO / OAuth2（六個必填，全有或全無）──
OIDC_AUTHORIZE_URL="http://127.0.0.1:4780/authorize"    # 開發：本機 mock  │ 生產：公司 IdP 授權端點
OIDC_TOKEN_URL="http://127.0.0.1:4780/token"            # 開發：本機 mock  │ 生產：公司 IdP token 端點
OIDC_USERINFO_URL="http://127.0.0.1:4780/userinfo"      # 開發：本機 mock  │ 生產：公司 IdP userinfo 端點
OIDC_CLIENT_ID="local-dev"                              # 開發：local-dev │ 生產：向 IdP 註冊後取得
OIDC_CLIENT_SECRET="local-dev-secret"                   # 開發：local-dev-secret │ 生產：向 IdP 註冊後取得
OIDC_REDIRECT_URI="http://127.0.0.1:3000/api/auth/callback"   # 開發： 同左    │ 生產：須與 IdP 端登記的回呼位址完全一致

# ── 首位平台管理員（不填則無人能授權他人）──
BOOTSTRAP_ADMIN_UID="mock-admin"  # 開發：mock-admin  │ 生產：須與 IdP 回傳的 uid 完全一致

# 這 7 行貼上後，npm run dev:idp 加 npm run dev 就能完整跑登入流程，mock-admin 登入後會拿到管理員權限。

# 選填（有預設值，開發期可不填）
#OIDC_SCOPE="openid profile"        # 預設 openid profile
#OIDC_CLAIM_UID="sub"               # 預設 sub
#OIDC_CLAIM_DISPLAY_NAME="name"     # 預設 name
#OIDC_CLAIM_TEAMS="groups"          # 預設 groups
#MOCK_IDP_PORT="4780"               # 預設 4780
#MOCK_IDP_HOST="127.0.0.1"          # 預設 127.0.0.1

# ── 10.10 通知（選填，等真實 webhook 憑證）──
# 不填就是站內通知照常，只是不外送。
#NOTIFY_SLACK_WEBHOOK_URL=""
#NOTIFY_TEAMS_WEBHOOK_URL=""
#NOTIFY_LARK_WEBHOOK_URL=""
#PLATFORM_BASE_URL=""               # 通知內連回平台的基底位址

# 資料庫健康輪詢間隔（毫秒），預設 60000。
# 注意：健康輪詢僅在上面三個 NOTIFY_*_WEBHOOK_URL 至少配置一個時才會啟動
#（src/server.ts:26-41 —— 沒有通知渠道時告警無處可送，故整段跳過）。
# 因此在通知未配置前，這個變數填了也不會生效。
#HEALTH_CHECK_INTERVAL_MS="60000"

#三個要注意的地方
#1. 六個 OIDC_* 必須全有或全無。 只填五個會在啟動時直接拋錯（這是刻意的 —— 半套配置會等到
#2. BOOTSTRAP_ADMIN_UID 打錯不會報錯。 該員工登入後就是拿不到權限，沒有任何提示。開發期填 mock-admin（mock IdP 的三個身份之一：mock-admin／mock-reviewer／mock-user）。
#3. 正式環境不接受本機位址。 OIDC_*_URL 指向 127.0.0.1／localhost 時，NODE_ENV=production  mock IdP 誤帶上線。
