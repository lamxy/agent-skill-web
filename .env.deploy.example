# 公網部署變數範本。複製為 .env.deploy 後填寫；.env.deploy 不進版本控制。
#
#   cp .env.deploy.example .env.deploy
#
# 完整上線步驟見 docs/公網部署指南.md。
# 本檔供 compose.public.yaml 使用（npm run public:up）。

# ══════════════════════════════════════════════════════════════
# 域名與憑證
# ══════════════════════════════════════════════════════════════

# 對外域名，不含 https:// 與結尾斜線。A 記錄須先指向本機公網 IP。
PUBLIC_DOMAIN="platform.example.com"

# Let's Encrypt 憑證到期通知信箱。
ACME_EMAIL="you@example.com"

# ══════════════════════════════════════════════════════════════
# 資料庫
# ══════════════════════════════════════════════════════════════

# 請用隨機值，勿沿用開發環境的 postgres：
#   openssl rand -base64 24
POSTGRES_PASSWORD="換成隨機密碼"
POSTGRES_DB="agent_skill_platform"
POSTGRES_USER="postgres"

# 主機名是 compose 服務名 postgres，不是 127.0.0.1。
# 密碼須與上面 POSTGRES_PASSWORD 完全一致，改一邊忘另一邊會導致連線失敗。
DATABASE_URL="postgresql://postgres:換成上面同一組密碼@postgres:5432/agent_skill_platform"

# ══════════════════════════════════════════════════════════════
# 平台
# ══════════════════════════════════════════════════════════════

LOG_LEVEL="info"

# 選填：遙測端點，不需要則留空。
TELEMETRY_ENDPOINT=""

# ══════════════════════════════════════════════════════════════
# 首位管理員
# ══════════════════════════════════════════════════════════════

# GitHub OAuth 請填「數字 ID」而非使用者名稱——使用者名稱可被更改，數字 ID 不會：
#   curl -s https://api.github.com/users/你的帳號 | grep '"id"'
#
# 該 uid 首次登入時自動獲得 platform_admin，之後不再觸發。
# 填錯不會報錯，症狀是登入後拿不到管理員權限，需自行核對。
BOOTSTRAP_ADMIN_UID="換成你的-GitHub-數字-ID"

# ══════════════════════════════════════════════════════════════
# 登入白名單（公網部署強烈建議設定）
# ══════════════════════════════════════════════════════════════

# 逗號分隔的 uid 清單。留空表示不限制，任何持有 GitHub 帳號者都能登入
# ——雖然沒有角色就沒有權限，但仍會在 identities 留下記錄。
#
# 必須包含上面的 BOOTSTRAP_ADMIN_UID，否則啟動時直接拋錯
# （漏掉會導致無人能登入，且症狀難以聯想到原因）。
#
# 同事的數字 ID 同樣用上面那道 curl 查詢。新增同事後重新 npm run public:up。
LOGIN_ALLOWED_UIDS="換成你的-GitHub-數字-ID,同事A的數字ID,同事B的數字ID"

# ══════════════════════════════════════════════════════════════
# SSO / OAuth2（六個必填，全有或全無）
# ══════════════════════════════════════════════════════════════

# 以下為 GitHub OAuth 的設定值。若改用公司內部 IdP，替換這一區即可，
# 其餘變數與部署步驟都不需要更動。
#
# 申請位置：GitHub → Settings → Developer settings → OAuth Apps → New OAuth App
#   Homepage URL:               https://你的域名
#   Authorization callback URL: https://你的域名/api/auth/callback
#
# callback URL 必須與 PUBLIC_DOMAIN 完全一致，多一個斜線都會失敗。

OIDC_AUTHORIZE_URL="https://github.com/login/oauth/authorize"
OIDC_TOKEN_URL="https://github.com/login/oauth/access_token"
OIDC_USERINFO_URL="https://api.github.com/user"
OIDC_CLIENT_ID="換成-OAuth-App-的-Client-ID"
OIDC_CLIENT_SECRET="換成-OAuth-App-的-Client-Secret"

# 注意：OIDC_REDIRECT_URI 由 compose.public.yaml 依 PUBLIC_DOMAIN 自動組出
# （https://${PUBLIC_DOMAIN}/api/auth/callback），不需在此填寫，填了也不會生效。

# GitHub 的 /user 回應欄位名與 OIDC 標準不同，需要對應：
#   id    數字 ID，穩定不變，作為 uid
#   name  顯示名稱
OIDC_SCOPE="read:user"
OIDC_CLAIM_UID="id"
OIDC_CLAIM_DISPLAY_NAME="name"

# GitHub 不提供群組資訊，留空即可（會退回預設值 groups，但 GitHub 的
# /user 回應沒有該欄位，結果就是團隊為空）。團隊歸屬由管理員在平台內指派。
OIDC_CLAIM_TEAMS=""

# ══════════════════════════════════════════════════════════════
# 通知（選填）
# ══════════════════════════════════════════════════════════════

# 不填就是站內通知照常，只是不外送。
# 若要啟用，PLATFORM_BASE_URL 由 compose 依 PUBLIC_DOMAIN 自動帶入，不需填寫。
NOTIFY_SLACK_WEBHOOK_URL=""
NOTIFY_TEAMS_WEBHOOK_URL=""
NOTIFY_LARK_WEBHOOK_URL=""
