  "includeGitInstructions": false,
  "env": {
    "CLAUDE_CODE_ATTRIBUTION_HEADER": "0",
    "DISABLE_AUTOUPDATER": "0",
    "DISABLE_FEEDBACK_COMMAND": "1",
    "DISABLE_TELEMETRY": "1",
    "DISABLE_ERROR_REPORTING": "1",
    "ENABLE_TOOL_SEARCH": "true",
    "CLAUDE_CODE_NEW_INIT": "1",
    "ENABLE_PROMPT_CACHING_1H": "1"
  },
  "model": "claude-sonnet-4-6",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "rtk hook claude"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "sh -c 'python3 -u ~/.claude/hooks/subagent_stop_gate.py 2>/tmp/subagent_hook_err.log || printf \"{\\\"decision\\\":\\\"approve\\\",\\\"reason\\\":\\\"hook skipped: python3 unavailable or crashed, see /tmp/subagent_hook_err.log\\\"}\"'"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "prompt",
            "timeout": 15,
            "prompt": "Before compaction, preserve only minimal verified state. Never block. Generate at most three short lines in systemMessage with this exact key style: keep.result=<...>; keep.risk=<low|medium|high|unknown>; keep.next=<...>. Include only if clearly supported by the latest verified context. If insufficient evidence, return JSON exactly: {}."
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "github@claude-plugins-official": true,
    "andrej-karpathy-skills@karpathy-skills": true,
    "superpowers@claude-plugins-official": true,
    "claude-code-setup@claude-plugins-official": true,
    "hookify@claude-plugins-official": true,
    "playground@claude-plugins-official": true,
    "optibot@claude-plugins-official": true,
    "commit-commands@claude-code-plugins": true,
    "context7@claude-plugins-official": true,
    "ralph-loop@claude-plugins-official": true,
    "session-report@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "claude-plugins-official": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-plugins-official"
      }
    },
    "claude-code-plugins": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-code"
      }
    },
    "karpathy-skills": {
      "source": {
        "source": "github",
        "repo": "forrestchang/andrej-karpathy-skills"
      }
    }
  },
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "autoAllowBashIfSandboxed": true,
    "allowUnsandboxedCommands": false,
    "network": {
      "allowedDomains": ["*"],
      "deniedDomains": ["gist.github.com"]
    },
    "filesystem": {
      "allowWrite": [
        "/tmp",
        "~/.cache",
        "~/.npm",
        "~/.pnpm-store",
        "~/.kube",
        "~/.cargo",
